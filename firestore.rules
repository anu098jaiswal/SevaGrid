// firestore.rules
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isSupervisor() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Workers read own profile; supervisors read all
      allow read: if isOwner(userId) || isSupervisor();
      // Only the user can create/update their own profile
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      // Workers read only their assigned tasks; supervisors read all
      allow read: if isAuth() && (
        resource.data.assignedToUserId == request.auth.uid || isSupervisor()
      );

      // Workers can update ONLY these fields on their own tasks:
      //   status, note, photoUrl, completedAt
      // They cannot change who the task is assigned to.
      allow update: if isAuth() && (
        (
          resource.data.assignedToUserId == request.auth.uid &&
          request.resource.data.assignedToUserId == resource.data.assignedToUserId &&
          request.resource.data.createdByUserId == resource.data.createdByUserId
        ) || isSupervisor()
      );

      // Only supervisors can create tasks
      allow create: if isSupervisor();

      // No deletes (keep audit trail)
      allow delete: if false;
    }
  }
}
